pipeline {
    agent { label 'skinai-cd' }
    options {
        disableConcurrentBuilds()
        skipDefaultCheckout()
    }
    triggers {
        upstream(upstreamProjects: 'SkinAI-Release-CI', threshold: hudson.model.Result.SUCCESS)
    }
    parameters {
        string(name: 'RELEASE_BUILD_NUMBER', defaultValue: '', trim: true,
               description: 'Manual deployment: successful SkinAI-Release-CI build number. Leave empty for automatic runs.')
    }
    stages {
        stage('Fetch exact release artifact') {
            steps {
                deleteDir()
                checkout scm
                script {
                    def causes = currentBuild.getBuildCauses()
                    def requested = (params.RELEASE_BUILD_NUMBER ?: '').trim()
                    if (causes.size() != 1) {
                        error('Expected exactly one unambiguous build cause')
                    }
                    def cause = causes[0]
                    if (cause._class == 'hudson.model.Cause$UpstreamCause') {
                        if (cause.upstreamProject != 'SkinAI-Release-CI' || requested) {
                            error('Automatic deployment requires one Release CI cause and no manual number')
                        }
                        env.RELEASE_BUILD = cause.upstreamBuild.toString()
                    } else if (cause._class == 'hudson.model.Cause$UserIdCause') {
                        env.RELEASE_BUILD = requested
                    } else {
                        error('Only Release CI completion or explicit manual deployment is supported')
                    }
                    if (!(env.RELEASE_BUILD ==~ /[1-9][0-9]*/)) {
                        error('Enter a positive Release CI build number for manual deployment')
                    }
                    timeout(time: 5, unit: 'MINUTES') {
                        def releaseRun = waitForBuild(
                            runId: "SkinAI-Release-CI#${env.RELEASE_BUILD}",
                            propagate: false, propagateAbort: false
                        )
                        if (releaseRun.result != 'SUCCESS') {
                            error("Release #${env.RELEASE_BUILD} is not SUCCESS")
                        }
                    }
                    currentBuild.description = "Release #${env.RELEASE_BUILD}"
                    echo "Verified successful Release #${env.RELEASE_BUILD}"
                }
                copyArtifacts(projectName: 'SkinAI-Release-CI',
                              selector: specific(env.RELEASE_BUILD), filter: 'release.json')
                echo "Deploying artifact from SkinAI-Release-CI #${env.RELEASE_BUILD}"
            }
        }
        stage('Prepare and verify deployment') {
            steps {
                withCredentials([string(credentialsId: 'skinai-cd-doctor-token',
                                        variable: 'SKINAI_E2E_DOCTOR_TOKEN')]) {
                    bat '''
@echo off
if not defined SKINAI_E2E_DOCTOR_TOKEN (
    echo CD doctor token is empty. Update the skinai-cd-doctor-token Secret text credential.
    exit /b 1
)
echo CD_DOCTOR_TOKEN_CONFIGURED=PASS
if not defined SKINAI_CD_DIR (
    echo SKINAI_CD_DIR is not configured.
    exit /b 1
)
if not exist "%SKINAI_CD_DIR%/runtime.env" (
    echo runtime.env is missing from the deployment directory.
    exit /b 1
)
if not defined SKINAI_E2E_SAMPLE (
    echo SKINAI_E2E_SAMPLE is not configured.
    exit /b 1
)
if not exist "%SKINAI_E2E_SAMPLE%" (
    echo The configured smoke-test sample file is missing.
    exit /b 1
)
set "CANDIDATE=%SKINAI_CD_DIR%/candidate-%BUILD_NUMBER%.json"
python -B cd/prepare_service_release.py release.json "%CANDIDATE%" || exit /b 1
python -B cd/deploy_service_release.py "%CANDIDATE%" --evidence "%WORKSPACE%/cd-evidence"
exit /b %ERRORLEVEL%
'''
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'release.json,cd-evidence/**/workflow-*-photos.json,cd-evidence/**/source-commit.txt',
                             fingerprint: true, allowEmptyArchive: true
        }
    }
}
