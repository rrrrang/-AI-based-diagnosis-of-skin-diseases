pipeline {
    agent { label 'skinai-cd' }
    options {
        disableConcurrentBuilds()
        skipDefaultCheckout()
    }
    triggers {
        upstream(upstreamProjects: 'SkinAI-Release-CI', threshold: hudson.model.Result.SUCCESS)
    }
    stages {
        stage('Fetch exact release artifact') {
            steps {
                deleteDir()
                checkout scm
                script {
                    def causes = currentBuild.getBuildCauses('hudson.model.Cause$UpstreamCause')
                    if (causes.size() != 1 || causes[0].upstreamProject != 'SkinAI-Release-CI') {
                        error('Expected one successful SkinAI-Release-CI upstream build')
                    }
                    env.RELEASE_BUILD = causes[0].upstreamBuild.toString()
                    if (!(env.RELEASE_BUILD ==~ /[1-9][0-9]*/)) {
                        error('Invalid upstream build number')
                    }
                }
                copyArtifacts(projectName: 'SkinAI-Release-CI',
                              selector: specific(env.RELEASE_BUILD), filter: 'release.json')
                echo "Deploying artifact from SkinAI-Release-CI #${env.RELEASE_BUILD}"
            }
        }
        stage('Prepare and verify deployment') {
            steps {
                dir('frontend/patient-frontend') {
                    bat 'npm ci --no-audit --no-fund'
                }
                withCredentials([string(credentialsId: 'skinai-cd-doctor-token',
                                        variable: 'SKINAI_E2E_DOCTOR_TOKEN')]) {
                    bat '''
@echo off
if not defined SKINAI_CD_DIR (
    echo SKINAI_CD_DIR is not configured.
    exit /b 1
)
if not exist "%SKINAI_CD_DIR%/runtime.env" (
    echo runtime.env is missing from the deployment directory.
    exit /b 1
)
if not defined SKINAI_E2E_SAMPLE (
    echo SKINAI_E2E_SAMPLE is not configured.
    exit /b 1
)
if not exist "%SKINAI_E2E_SAMPLE%" (
    echo The configured smoke-test sample file is missing.
    exit /b 1
)
set "SKINAI_E2E_OUTPUT=%WORKSPACE%/cd-evidence"
set "CANDIDATE=%SKINAI_CD_DIR%/candidate-%BUILD_NUMBER%.json"
python -B cd/prepare_service_release.py release.json "%CANDIDATE%" || exit /b 1
pushd "%WORKSPACE%/frontend/patient-frontend" || exit /b 1
python -B "%WORKSPACE%/cd/deploy_service_release.py" "%CANDIDATE%" node node_modules/playwright/cli.js test --config playwright.release.config.ts
exit /b %ERRORLEVEL%
'''
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'release.json,cd-evidence/workflow-*-photos.json',
                             fingerprint: true, allowEmptyArchive: true
        }
    }
}
