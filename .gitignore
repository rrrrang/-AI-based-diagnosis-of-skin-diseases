$gi = @'
# 데이터와 중간 산출물 (이미지·원본 라벨은 저장소에 올리지 않음)
data/
data_front_backup/
outputs/
cache256/
yolo_cls/

# 환경
.venv/
__pycache__/
*.pyc

# 이미지는 전역 차단 (데이터셋 이미지가 섞여 들어가는 사고 방지)
*.png
*.jpg
*.jpeg
*.bmp
*.webp
'@
[System.IO.File]::WriteAllText("$PWD\.gitignore", $gi, (New-Object System.Text.UTF8Encoding($false)))
git status --short
$utf8 = New-Object System.Text.UTF8Encoding($false)
if (Test-Path .gitignore) { [System.IO.File]::AppendAllText("$dst\.gitignore", $rules, $utf8) }
else { [System.IO.File]::WriteAllText("$dst\.gitignore", $rules.TrimStart(), $utf8) }