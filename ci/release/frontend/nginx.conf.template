worker_processes auto;
pid /tmp/nginx.pid;
# Nginx request error messages may include the full URI. Keep request data out
# of logs; operational status and timings remain available in the access log.
error_log /dev/null;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    etag off;

    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    # No URI, query, remote address, header, cookie, authorization or body.
    log_format minimal '$request_method $status $body_bytes_sent $request_time';
    access_log /dev/stdout minimal;

    # Docker's embedded DNS allows the API container to be replaced without
    # restarting either UI and keeps /healthz independent of API availability.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    server {
        listen 8080;
        listen [::]:8080;
        server_name _;
        root /usr/share/nginx/html;
        index index.html;

        # Three 8 MiB photos plus multipart overhead. Per-file validation stays
        # in the API; this is only the outer request-envelope limit.
        client_max_body_size 26m;
        client_body_timeout ${SKINAI_PROXY_TIMEOUT};
        send_timeout ${SKINAI_PROXY_TIMEOUT};

        add_header Cache-Control 'no-store, max-age=0' always;
        add_header Pragma 'no-cache' always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;

        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 'ok\n';
        }

        # Match /api and /api/... only; never send API errors to SPA fallback.
        location ~ ^/api(?:/|$) {
            set $api_upstream api:8000;
            proxy_pass http://$api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection '';
            proxy_connect_timeout ${SKINAI_PROXY_TIMEOUT};
            proxy_send_timeout ${SKINAI_PROXY_TIMEOUT};
            proxy_read_timeout ${SKINAI_PROXY_TIMEOUT};
            proxy_redirect off;
            proxy_intercept_errors off;
            proxy_next_upstream off;
            proxy_cache off;
            proxy_store off;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_max_temp_file_size 0;
            proxy_hide_header Cache-Control;
            proxy_hide_header Expires;
            proxy_hide_header Pragma;
        }

        location ~ (^|/)\. {
            return 404;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
