pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 15, unit: 'MINUTES')
    }

    environment {
        TEST_BASE_URL = 'http://127.0.0.1:18120'
        TEST_COMPOSE_FILE = 'compose.ci.yaml'
        TEST_PROJECT_NAME = "skinai-two-server-ci-${env.BUILD_NUMBER}"
        DOCKERHUB_CREDENTIALS_ID = 'skinai-dockerhub'
        CENTRAL_HUB_REPO = 'rlarns982/skinai-central-lab'
        AI_MOCK_HUB_REPO = 'rlarns982/skinai-ai-mock-lab'
    }

    stages {
        stage('1. Git 코드 가져오기') {
            steps {
                script {
                    env.CI_START_ATTEMPTED = 'false'
                    if (isUnix()) {
                        error('이 실습 Jenkinsfile은 Windows 실행 환경용입니다.')
                    }
                    // Jenkins 노드의 CI_DOCKER_EXE, CI_PYTHON_EXE로 경로를 바꿀 수 있습니다.
                    env.DOCKER_EXE = env.CI_DOCKER_EXE ?: "${env.LOCALAPPDATA}/Programs/DockerDesktop/resources/bin/docker.exe"
                    env.PYTHON_EXE = env.CI_PYTHON_EXE ?: 'D:/miniconda3/python.exe'
                }

                dir("runs/${env.BUILD_NUMBER}/source") {
                    script {
                        def revision = checkout scm
                        env.SOURCE_COMMIT = revision.GIT_COMMIT
                        env.IMAGE_TAG = "sha-${env.SOURCE_COMMIT.take(12)}-build-${env.BUILD_NUMBER}"
                    }
                    echo "검사할 Git 커밋: ${env.SOURCE_COMMIT}"
                    echo "이번 이미지 버전: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('CI 규칙 검사 (합성 응답과 파일)') {
            steps {
                dir("runs/${env.BUILD_NUMBER}/source/ci") {
                    bat encoding: 'UTF-8', script: '''
@echo off
"%PYTHON_EXE%" -B -X utf8 -m unittest -v test_responses test_model_package
'''
                }
            }
        }

        stage('모델 파일 인수 검사 (자료 지정 시)') {
            when {
                expression {
                    return env.CI_MODEL_DIR?.trim() || env.CI_MODEL_WEIGHTS_SHA256?.trim() || env.CI_MODEL_WEIGHTS_FILE?.trim()
                }
            }
            steps {
                dir("runs/${env.BUILD_NUMBER}/source/ci") {
                    powershell encoding: 'UTF-8', script: '''
                        $ErrorActionPreference = 'Stop'
                        if ([string]::IsNullOrWhiteSpace($env:CI_MODEL_DIR) -or [string]::IsNullOrWhiteSpace($env:CI_MODEL_WEIGHTS_SHA256)) {
                            throw 'Set both CI_MODEL_DIR and CI_MODEL_WEIGHTS_SHA256 for model intake.'
                        }
                        $weightsFile = $env:CI_MODEL_WEIGHTS_FILE
                        if ([string]::IsNullOrWhiteSpace($weightsFile)) { $weightsFile = 'model.pt' }
                        & $env:PYTHON_EXE -B -X utf8 check_model_package.py $env:CI_MODEL_DIR --weights-sha256 $env:CI_MODEL_WEIGHTS_SHA256 --weights-file $weightsFile
                        exit $LASTEXITCODE
                    '''
                }
            }
        }

        stage('2. 중앙 서버 이미지 만들기') {
            steps {
                dir("runs/${env.BUILD_NUMBER}/source/labs/two_server_lab") {
                    bat encoding: 'UTF-8', script: '''
@echo off
"%DOCKER_EXE%" build --load --progress=plain -f central/Dockerfile -t skinai-two-server-central:%IMAGE_TAG% .
'''
                }
            }
        }

        stage('3. 임시 AI 서버 이미지 만들기') {
            steps {
                dir("runs/${env.BUILD_NUMBER}/source/labs/two_server_lab") {
                    bat encoding: 'UTF-8', script: '''
@echo off
"%DOCKER_EXE%" build --load --progress=plain -f ai_mock/Dockerfile -t skinai-two-server-ai-mock:%IMAGE_TAG% .
'''
                }
            }
        }

        stage('4. 별도 테스트 서버 실행') {
            steps {
                dir("runs/${env.BUILD_NUMBER}/source/labs/two_server_lab") {
                    bat encoding: 'UTF-8', script: '''
@echo off
"%DOCKER_EXE%" compose -p "%TEST_PROJECT_NAME%" -f "%TEST_COMPOSE_FILE%" config --quiet
'''

                    script {
                        env.CI_START_ATTEMPTED = 'true'
                    }

                    bat encoding: 'UTF-8', script: '''
@echo off
"%DOCKER_EXE%" compose -p "%TEST_PROJECT_NAME%" -f "%TEST_COMPOSE_FILE%" up -d --no-build --pull never --wait --wait-timeout 60
'''
                }
            }
        }

        stage('5. 장애 및 복구 자동검사') {
            steps {
                dir("runs/${env.BUILD_NUMBER}/source/labs/two_server_lab") {
                    bat encoding: 'UTF-8', script: '''
@echo off
"%PYTHON_EXE%" -X utf8 test_recovery.py
'''
                }
            }
        }
        stage('6. Docker Hub에 두 이미지 업로드') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.DOCKERHUB_CREDENTIALS_ID,
                    usernameVariable: 'HUB_USER',
                    passwordVariable: 'HUB_TOKEN'
                )]) {
                    powershell encoding: 'UTF-8', script: '''
                        $ErrorActionPreference = 'Stop'

                        $pair = $env:HUB_USER + ':' + $env:HUB_TOKEN
                        $auth = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($pair))
                        $env:DOCKER_AUTH_CONFIG = @{
                            auths = @{ 'https://index.docker.io/v1/' = @{ auth = $auth } }
                        } | ConvertTo-Json -Depth 4 -Compress

                        function Invoke-Docker {
                            & $env:DOCKER_EXE @args
                            if ($LASTEXITCODE -ne 0) {
                                throw "Docker $($args[0]) failed (exit $LASTEXITCODE)"
                            }
                        }

                        $tag = $env:IMAGE_TAG
                        $central = "$($env:CENTRAL_HUB_REPO):$tag"
                        $aiMock  = "$($env:AI_MOCK_HUB_REPO):$tag"

                        Invoke-Docker tag "skinai-two-server-central:$tag" $central
                        Invoke-Docker tag "skinai-two-server-ai-mock:$tag" $aiMock
                        Invoke-Docker push $central | Tee-Object -FilePath "runs/$env:BUILD_NUMBER/central-push.log"
                        Invoke-Docker push $aiMock  | Tee-Object -FilePath "runs/$env:BUILD_NUMBER/ai-mock-push.log"
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.CI_START_ATTEMPTED == 'true') {
                    timeout(time: 2, unit: 'MINUTES') {
                        dir("runs/${env.BUILD_NUMBER}/source/labs/two_server_lab") {
                            echo "이번 빌드의 테스트 서버를 정리합니다."

                            bat encoding: 'UTF-8', script: '''
@echo off
"%DOCKER_EXE%" compose -p "%TEST_PROJECT_NAME%" -f "%TEST_COMPOSE_FILE%" down --timeout 10
'''
                        }
                    }
                }
            }
        }
        success {
            dir("runs/${env.BUILD_NUMBER}") {
                powershell encoding: 'UTF-8', script: '''
                    $ErrorActionPreference = 'Stop'

                    function Get-ImageRecord($repo, $logFile) {
                        $pattern = '^' + [regex]::Escape($env:IMAGE_TAG) + ': +digest: +(sha256:[0-9a-f]{64}) +size:'
                        $found = @(Select-String -LiteralPath $logFile -Pattern $pattern)
                        if ($found.Count -ne 1) {
                            throw "Expected one push digest in $logFile"
                        }

                        $digest = $found[0].Matches[0].Groups[1].Value
                        return [ordered]@{
                            repository = "docker.io/$repo"
                            tag = $env:IMAGE_TAG
                            digest = $digest
                            image = "docker.io/$repo@$digest"
                        }
                    }

                    $release = [ordered]@{
                        release_id = $env:IMAGE_TAG
                        practice_only = $true
                        model_loaded = $false
                        source = @{
                            repository = 'https://github.com/rrrrang/-AI-based-diagnosis-of-skin-diseases'
                            branch = 'ci/two-server-lab'
                            commit = $env:SOURCE_COMMIT
                        }
                        ci = @{
                            job = $env:JOB_NAME
                            build = [int]$env:BUILD_NUMBER
                            result = 'SUCCESS'
                        }
                        platform = 'linux/amd64'
                        services = [ordered]@{
                            central = Get-ImageRecord $env:CENTRAL_HUB_REPO 'central-push.log'
                            'ai-mock' = Get-ImageRecord $env:AI_MOCK_HUB_REPO 'ai-mock-push.log'
                        }
                    }

                    $json = $release | ConvertTo-Json -Depth 5
                    [IO.File]::WriteAllText((Join-Path $PWD 'release.json'), $json)
                '''
                archiveArtifacts artifacts: 'release.json', fingerprint: true
            }
        }
    }
}
