{
  "name": "final_v0_1",
  "data": {
    "meta_csv": "outputs/meta_split_block.csv",
    "label_map": "outputs/label2id.json",
    "path_remap": null
  },
  "model": {"arch": "mobilenet_v3_small", "pretrained": true},
  "train": {
    "img_size": 224,
    "epochs": 6,
    "batch_size": 32,
    "lr": 0.0003,
    "weight_decay": 0.01,
    "label_smoothing": 0.1,
    "patience": 4,
    "num_workers": 2
  },
  "aug": {
    "random_resized_crop_scale": [0.6, 1.0],
    "hflip": true,
    "vflip": true,
    "rotation": 20,
    "color_jitter": {"brightness": 0.15, "contrast": 0.15, "saturation": 0.1, "hue": 0.02},
    "channel_gain": [0.88, 1.12],
    "blur": {"p": 0.3, "sigma": [0.3, 1.5]},
    "jpeg": null,
    "grayscale": false
  },
  "threshold": {"percentile": 5, "min": 0.30, "max": 0.90}
}